# Copy to .env.local for local development. Never commit real values.
# In production these live in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL of the app (used in emails and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Milestone 2: Google service account that companies share their sheets with (whole JSON key)
GOOGLE_SERVICE_ACCOUNT_JSON=
