# Copy to .env.local for local development. Never commit real values.
# In production these live in Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The public URL of the app (used in emails and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google service account that companies share their sheets with (whole JSON key)
GOOGLE_SERVICE_ACCOUNT_JSON=

# "Connect Google" (OAuth client: Web application, redirect URI <site>/api/google/callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Picker: browser API key (restricted to your site + Picker API) and the Cloud project NUMBER
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
# 32 random bytes, base64. Encrypts stored Google tokens. Never change it once set.
TOKEN_ENC_KEY=

# Background sync: same value as the Supabase Vault secret from supabase/setup/cron.sql
CRON_SECRET=

# Shown on /privacy and /terms
NEXT_PUBLIC_CONTACT_EMAIL=
